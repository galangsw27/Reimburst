# Reimbursement AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ======================
# DATABASE CONFIGURATION
# ======================
# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/reimbursement_db
# Railway: Automatically provided by Railway (don't set manually)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reimbursement_db

# ======================
# JWT CONFIGURATION
# ======================
# Secret key for JWT token signing (CHANGE IN PRODUCTION!)
JWT_SECRET=your-secret-key-change-in-production
# Token expiration time (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# ======================
# APPLICATION SETTINGS
# ======================
# Node environment (development, production)
NODE_ENV=development
# Port for the application (Railway sets this automatically)
PORT=3000

# ======================
# WEBHOOK URLS
# ======================
# n8n Webhook URL for AI OCR (Receipt Processing)
NEXT_PUBLIC_WEBHOOK_URL=

# n8n Webhook URL for AI Asset Matching
NEXT_PUBLIC_ASSET_MATCH_WEBHOOK_URL=

# Google Apps Script Webhook URLs (NO OAUTH REQUIRED)
# Setup: See GOOGLE_APPS_SCRIPT_SETUP.md
# Format: https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# MaxStream Project
NEXT_PUBLIC_MAXSTREAM_WEBHOOK_URL=

# MyOrbit Project
NEXT_PUBLIC_MYORBIT_WEBHOOK_URL=

# Dunia Games Project
NEXT_PUBLIC_DUNIAGAMES_WEBHOOK_URL=

# ======================
# GOOGLE OAUTH (Optional)
# ======================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ======================
# RAILWAY DEPLOYMENT
# ======================
# Railway automatically provides these variables:
# - DATABASE_URL (from PostgreSQL service)
# - PORT (assigned by Railway)
# - RAILWAY_ENVIRONMENT (production, staging, etc)
# - RAILWAY_PROJECT_ID
# - RAILWAY_SERVICE_ID
#
# You only need to set in Railway dashboard:
# - JWT_SECRET (required)
# - NEXT_PUBLIC_* variables (if using webhooks/oauth)
