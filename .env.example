# Reimbursement AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# n8n Webhook URL for AI OCR (Receipt Processing)
VITE_WEBHOOK_URL=

# n8n Webhook URL for AI Asset Matching
VITE_ASSET_MATCH_WEBHOOK_URL=

# Google Apps Script Webhook URLs (NO OAUTH REQUIRED)
# Setup: See GOOGLE_APPS_SCRIPT_SETUP.md
# Format: https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# MaxStream Project
VITE_MAXSTREAM_WEBHOOK_URL=

# MyOrbit Project
VITE_MYORBIT_WEBHOOK_URL=

# Dunia Games Project
VITE_DUNIAGAMES_WEBHOOK_URL=

# Database Configuration
# Note: Application is now hardcoded to use database mode
# DATABASE_MODE is no longer used - always uses database
# Set DATABASE_URL to your PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Default: postgresql://postgres:postgres@localhost:5432/reimbursement_db
DATABASE_URL=
