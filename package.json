{
  "name": "airism",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AIRism - AI Reimbursement System with automated receipt processing",
  "scripts": {
    "dev": "next dev",
    "dev:db": "DATABASE_MODE=database DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reimbursement_db next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "dev:vite": "vite --port 5173",
    "build:vite": "tsc && vite build",
    "preview:vite": "vite preview",
    "db:seed": "tsx scripts/seed.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:clean": "docker-compose down -v",
    "health": "curl -s http://localhost:3000/api/health | jq .",
    "monitor": "bash scripts/monitor.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-oauth/google": "^0.13.4",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.15.0",
    "gapi-script": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.1.3",
    "pg": "^8.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^25.0.8",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
